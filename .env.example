# Firebase Configuration
# Option 1: Paste your entire Firebase service account JSON here
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 2: Leave empty - server will try to load from:
#   - firebase-service-account.json (in this folder)
#   - Your Downloads folder

# API Keys (optional - only needed for AI features)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here

# Server Port (optional)
PORT=10000